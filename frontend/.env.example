# Copie este arquivo para .env e preencha apenas no ambiente local.
# URL da API em builds publicados (vazio = mesma origem; em dev o Vite faz proxy de /api)
VITE_API_URL=
# Destino do proxy /api no servidor de desenvolvimento (não vai para o bundle)
API_PROXY_TARGET=http://127.0.0.1:3000
# API separada para o seletor de demonstração no Perfil
DEMO_API_PROXY_TARGET=http://127.0.0.1:3001
